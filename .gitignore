audio/*
txt/*
output/*
profiles/*

# Garder la structure des dossiers dans Git
!audio/.gitkeep
!txt/.gitkeep
!output/.gitkeep
!profiles/.gitkeep

# Gros fichiers et donnees sensibles
*.pkl
*.pt
*.pth
*.safetensors
*.ckpt
*.onnx
