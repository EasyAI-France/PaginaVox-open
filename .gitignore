# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
nul

# Environnements locaux
env/
venv/
.venv/
ENV/

# Builds executables
build/pyinstaller/
build/specs/
dist/
*.spec
!build/PaginaVox.spec

# Rendus temporaires de notices
notice_cli_render/
gradio/notice_gradio_render/
Docker/notice_render/

